# Explicit sdist file policy (audit-4 HIGH): internal review/audit notes must
# never ship inside the published package. Wheels only contain files under
# src/ anyway; this file governs the sdist.
prune .contract
exclude BUILD_LOG.md
exclude MANIFEST.in
global-exclude __pycache__
global-exclude *.py[cod]

# Public docs shipped in the sdist.
include README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md llms.txt LICENSE
include man/okfsmith.1
include completions/okfsmith.bash completions/okfsmith.zsh completions/okfsmith.fish
recursive-include docs *.md
recursive-include skills *.md
